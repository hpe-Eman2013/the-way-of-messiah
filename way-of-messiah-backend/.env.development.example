# Backend (development)
NODE_ENV=development
PORT=10000


# Frontend URL used to build Stripe redirect URLs
FRONTEND_URL=http://localhost:5173
DONATION_SUCCESS_PATH=/donate/thank-you
DONATION_CANCEL_PATH=/donate


# Stripe (TEST mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx
# Optional if you use a shared monthly product
STRIPE_MONTHLY_PRODUCT_ID=prod_test_xxx


# Database / Auth (dev)
MONGO_URI=mongodb+srv://user:pass@cluster-dev.mongodb.net/yourdb
JWT_SECRET=dev_secret_change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me